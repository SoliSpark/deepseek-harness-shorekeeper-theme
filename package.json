{
  "name": "@local/dsh-shorekeeper-startup",
  "version": "1.2.2",
  "private": true,
  "description": "守岸人主题与伴侣：逐笔线稿启动动画、全屏背景、桌宠、聊天终端、GPT-SoVITS 语音与音乐播放器。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "build.mjs",
    "client.template.js",
    "voicepack.json",
    "README.md",
    "安装说明.txt",
    "使用说明.txt",
    "assets/startup.mp4",
    "assets/loop.mp4",
    "assets/startup_voice.mp3",
    "assets/sketch_paths.json",
    "assets/logo.svg",
    "assets/logo_parts.json",
    "assets/pet.png",
    "assets/portrait.webp",
    "assets/face.webp",
    "assets/butterfly.webp",
    "assets/default_track.m4a"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
